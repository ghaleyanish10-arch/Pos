# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mesa_os?sslmode=disable

# ---- Server ----
PORT=8080
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173

# ---- Email (Resend) — real delivery, works from localhost ----
# Get your key at https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=
# While unverified, this MUST be onboarding@resend.dev; after domain
# verification, use any address @your-domain (e.g. hello@mesa.example)
EMAIL_FROM=onboarding@resend.dev
# Display name on outgoing emails
EMAIL_FROM_NAME=Mesa OS
# Where emailed links point — the LOCAL frontend URL (Vite default 5173)
APP_URL=http://localhost:5173

# ---- SMTP / Gmail - OTP verification codes + receipts ----
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=<your gmail
# address>, SMTP_PASSWORD=<16-char App Password>. Create the App Password at
# https://myaccount.google.com/security (needs 2-Step Verification on).
# A normal Gmail login password will NOT work - Google rejects it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Google OAuth (admin/owner signup) ----
# Create a Google Cloud OAuth 2.0 client at
# https://console.cloud.google.com/apis/credentials — add the Callback URI
# http://localhost:8080/api/v1/auth/google/callback in "Authorized redirect URIs".
# Leave empty to disable the "Sign up with Google" button (email + password works alone).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in the Google Cloud console.
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
