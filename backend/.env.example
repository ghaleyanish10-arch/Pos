# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mesa_os?sslmode=disable

# ---- Server ----
PORT=8080
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173

# ---- Email (Resend) — real delivery, works from localhost ----
# Get your key at https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=
# While unverified, this MUST be onboarding@resend.dev; after domain
# verification, use any address @your-domain (e.g. hello@mesa.example)
EMAIL_FROM=onboarding@resend.dev
# Display name on outgoing emails
EMAIL_FROM_NAME=Mesa OS
# Where emailed links point — the LOCAL frontend URL (Vite default 5173)
APP_URL=http://localhost:5173

# ---- SMTP (legacy receipt flow; optional now that Resend is configured) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
